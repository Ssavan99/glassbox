    {
      "id": "n1",
      "kind": "route",
      "label": "Route question to hybrid",
      "parent_ids": [],
      "duration_ms": 0.2327920010429807,
      "explain": "This is the one genuinely LLM-driven routing decision in the whole project: the LLM classifies the question and picks which entire architecture -- not which retrieval tool -- is best suited to answer it, weighing tradeoffs like keyword-sensitivity, multi-hop complexity, or likely-unanswerability. Contrast this with Agentic's `route` node, which shares this node kind but is a zero-cost deterministic heuristic picking a retrieval tool for one sub-question, not an LLM judgment picking a pipeline. If the router's response was malformed, missing, or named an architecture that doesn't exist, this falls back to naive as the safe default rather than crashing or guessing.",
      "payload": {
        "chosen": "hybrid",
        "scores": {
          "naive": 0.12,
          "hybrid": 0.81,
          "hyde": 0.15,
          "corrective": 0.1,
          "graph": 0.05,
          "agentic": 0.07
        },
        "reason": "The query asks for two exact numeric parameters (target size and overlap size) \u2013 a classic case for needing verbatim values. Hybrid retrieval (dense + BM25 with reranking) is best at pulling precise strings from the corpus, whereas other architectures are less suited."
      }
    },
